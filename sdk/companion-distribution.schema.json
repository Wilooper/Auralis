{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReVa companion distribution envelope (future installer contract)",
  "description": "Schema for data obtained from a safely parsed YAML document. It is not an executable loader or a substitute for APK signature, Android package and host compatibility verification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "id", "name", "packageName", "hostSdk", "androidMinSdk", "abis", "artifact", "publisherCertificateSha256", "capabilities", "dependencies"],
  "properties": {
    "manifestVersion": {"const": 2},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+){1,7}$", "maxLength": 80},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "packageName": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(?:\\.[a-zA-Z][a-zA-Z0-9_]*)+$", "maxLength": 160},
    "hostSdk": {
      "type": "object", "additionalProperties": false, "required": ["min", "max"],
      "properties": {"min": {"const": 2}, "max": {"const": 2}}
    },
    "androidMinSdk": {"type": "integer", "minimum": 26, "maximum": 36},
    "abis": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["any", "arm64-v8a", "armeabi-v7a", "x86_64"]}},
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["url", "sha256", "sizeBytes"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://[^/@?#\\s]+/[^\\s]*$", "maxLength": 2048},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 134217728}
      }
    },
    "publisherCertificateSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "capabilities": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "contains": {"const": "ui.actions"}, "items": {"enum": ["ui.actions", "network.fetch", "share.text", "compute.background"]}},
    "dependencies": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "version", "license"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 160},
          "version": {"type": "string", "minLength": 1, "maxLength": 80},
          "license": {"type": "string", "minLength": 1, "maxLength": 80}
        }
      }
    }
  }
}
