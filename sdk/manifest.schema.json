{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auralis.example/schemas/extension-v1",
  "title": "Auralis SDK v1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "name",
    "version",
    "capabilities",
    "origins"
  ],
  "properties": {
    "apiVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+){1,7}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "enum": [
          "catalog.read",
          "stream.play",
          "party.session",
          "web.embed",
          "skin.apply"
        ]
      }
    },
    "origins": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://[^/?#@]+$"
      }
    },
    "skin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "textScale": {
          "type": "number",
          "minimum": 0.85,
          "maximum": 1.3
        },
        "rowHeight": {
          "type": "integer",
          "minimum": 64,
          "maximum": 112
        },
        "cornerRadius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "artworkSize": {
          "type": "integer",
          "minimum": 40,
          "maximum": 80
        },
        "layout": {
          "enum": [
            "standard",
            "compact",
            "covers"
          ]
        },
        "font": {
          "enum": [
            "sans",
            "serif",
            "mono"
          ]
        },
        "atmosphere": {
          "type": "boolean"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogUrl"
      ],
      "properties": {
        "catalogUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://"
        }
      }
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://"
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://"
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "provider"
      ]
    },
    {
      "required": [
        "skin"
      ]
    },
    {
      "required": [
        "party"
      ]
    },
    {
      "required": [
        "web"
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "provider"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "catalog.read"
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "skin"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "skin.apply"
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "web"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "web.embed"
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "party"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "party.session"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "stream.play"
            }
          }
        }
      },
      "then": {
        "required": [
          "provider"
        ]
      }
    }
  ]
}
